# ctl.sh status 输出基线（1.2.8 抓取：设备 6.6.77 / android15-6.6 / SukiSU）
# 用途：重构 status（去 fork）后逐字段比对；除 [volatile] 段列出的键外不得有差异。
# 抓取：adb shell su -c 'cd /data/adb/modules/susfs_allinone && sh ctl.sh status'

[keys]  # 顺序即输出顺序，重构后必须一致
module_version
install_id
description
kernel
kmi
lkm_present
susfs_kernel
lkm_variant
lkm_version
rules
hide_kernelsu
marker
auto_load
root_manager
ksu_bin
ksu_bin_path
selinux
fail_count
apply_fails
pid_guard_enabled
pid_guard_loaded
pid_guard_visible
pid_guard_hidden
pid_guard_result
pid_guard_uids
pid_guard_comms
kernelpatch
apatch_userland
kernelpatch_kernel
kernelpatch_version
coexist_mode
allow_lkm
config_ksu
config_ksu_susfs
apply_result
boot_stage_completed
backend_kind
backend_interface_detected
abi_match
effect_verified
tool_query
crash_evidence
lkm_size
autoload
sus_mount
try_umount
bootloader
force_bl_unlocked
integrity

[volatile]  # 值随设备/时间变化，比对时只校验键存在
apply_fails
apply_result
autoload
boot_stage_completed
bootloader
config_ksu
config_ksu_susfs
crash_evidence
effect_verified
fail_count
force_bl_unlocked
hide_kernelsu
install_id
integrity
kernel
kernelpatch
kernelpatch_kernel
kernelpatch_version
kmi
ksu_bin
ksu_bin_path
lkm_present
lkm_size
lkm_variant
lkm_version
marker
pid_guard_comms
pid_guard_enabled
pid_guard_hidden
pid_guard_loaded
pid_guard_result
pid_guard_uids
pid_guard_visible
root_manager
rules
selinux
sus_mount
susfs_kernel
tool_query
try_umount
abi_match
allow_lkm
apatch_userland
backend_interface_detected
backend_kind
coexist_mode
description
module_version
